#!/usr/bin/env bash
# pi sessions running outside a multiplexer.
#
# pi keeps no live session record, so a running session is found by its process
# and described by the newest transcript under its working directory. State is
# inferred from how recently that transcript was written, which is why pi never
# reports "blocked": nothing on disk distinguishes a permission prompt from a
# long tool call. Run pi inside herdr and the herdr collector supplies a real
# status for it instead.
set -uo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/lib/collector.sh"

PI_HOME="${PI_HOME:-$HOME/.pi/agent}"
SESSION_ROOT="$PI_HOME/sessions"

# A running pi presents itself as plain "pi" — no interpreter, no script path —
# so match the process name. This collector is also called "pi", hence the
# interpreter check below: a shell wearing the name is not the agent.
mapfile -t pids < <(pgrep -x pi 2>/dev/null)

# pi stores transcripts under a slug of the cwd: /home/x/y becomes --home-x-y--
slug_for() {
  printf -- '--%s--' "$(printf '%s' "${1#/}" | tr '/' '-')"
}

now=$(date +%s)
records=()

for pid in "${pids[@]}"; do
  alive "$pid" || continue
  [[ $pid == "$$" ]] && continue
  exe=$(basename "$(readlink -f "/proc/$pid/exe" 2>/dev/null)" 2>/dev/null)
  [[ $exe == bash || $exe == sh || $exe == dash || $exe == zsh ]] && continue

  cwd=$(cwd_of "$pid")
  [[ -n $cwd ]] || continue

  dir_slug=$(slug_for "$cwd")
  transcript=$(newest "$SESSION_ROOT/$dir_slug"/*.jsonl)
  state=$(state_from_mtime "$transcript")
  age=$(age_of_file "$transcript")

  # pi has no title of its own; the first user message is the closest thing.
  title=""
  if [[ -n $transcript ]]; then
    title=$(grep -o '"text":"[^"]\{1,120\}"' "$transcript" 2>/dev/null | head -1 |
      sed 's/^"text":"//; s/"$//')
  fi
  [[ -n $title ]] || title="pi session"

  records+=("$(jq -nc \
    --argjson pid "$pid" \
    --arg cwd "$cwd" \
    --arg dir "$(shorten_dir "$cwd")" \
    --arg title "$title" \
    --arg transcript "$transcript" \
    --arg state "$state" \
    --argjson age "$age" \
    --argjson started "$((now - $(stat -c %Y "/proc/$pid" 2>/dev/null || echo "$now")))" \
    '{
      agent: "pi",
      priority: 2,
      pid: $pid,
      # herdr identifies a pi session by its transcript path, so carrying the
      # same value here is what lets the two sightings merge into one row.
      sessionId: (if $transcript == "" then null else $transcript end),
      name: ("pi-" + ($pid | tostring)),
      cwd: $cwd,
      dir: $dir,
      title: $title,
      state: $state,
      raw: $state,
      ageSec: $age,
      startedSec: $started,
      host: "window"
    }')")
done

if [[ ${#records[@]} -eq 0 ]]; then
  echo '[]'
else
  printf '%s\n' "${records[@]}" | jq -s '.'
fi
